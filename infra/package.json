{
  "name": "infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "synth": "cdk synth --strict -c stage=test --profile subskeeper",
    "diff:test": "cdk diff -c stage=test --profile subskeeper",
    "diff:prod": "cdk diff -c stage=prod --profile subskeeper",
    "deploy:test": "cdk deploy --all -c stage=test --profile subskeeper --outputs-file cdk-outputs.test.json && npm run env",
    "deploy:prod": "cdk deploy --all -c stage=prod --profile subskeeper --outputs-file cdk-outputs.prod.json",
    "env": "node scripts/write-frontend-env.js"
  },
  "devDependencies": {
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1"
  }
}
